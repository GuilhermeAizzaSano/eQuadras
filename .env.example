# ==========================================
# eQuadras - Environment Variables Template
# ==========================================

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/equadras_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Payment Gateway (Mercado Pago Sandbox/Production)
# Deixe em branco ou informe seu Access Token (TEST-...)
MERCADOPAGO_ACCESS_TOKEN=

# JWT - obrigatorio em producao, minimo 32 caracteres aleatorios
JWT_SECRET=

# Frontend Base API URL (Vite)
VITE_API_URL=http://localhost:8080
